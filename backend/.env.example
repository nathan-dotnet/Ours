# ASP.NET Core reads configuration from appsettings.json, environment variables (with `__` as
# the section separator), and — for local development — `dotnet user-secrets` (see backend/README.md
# for the exact `dotnet user-secrets set` commands). This file documents the required values for
# a production-style deployment; it is not loaded automatically by the app.

ConnectionStrings__Default=Host=localhost;Port=5432;Database=ours;Username=ours_app;Password=CHANGE_ME

# Generate with: openssl rand -base64 48
Jwt__Secret=CHANGE_ME
Jwt__Issuer=Ours
Jwt__Audience=OursApp
Jwt__AccessTokenMinutes=15

# Deep link the password-reset email points at (must match app.json's "scheme" + the mobile
# route it opens — see mobile/app/reset-password.tsx). No need to change this for local dev.
App__PasswordResetUrl=ours://reset-password

# Email — how forgot-password delivers its reset link.
#   - "development" (default; no other Email__* values needed): logs the full reset link to the
#     console instead of sending anything, so you can test the flow with zero email credentials.
#   - "smtp": sends real mail via the SMTP settings below (any provider that speaks SMTP —
#     Gmail, Mailtrap for testing, SendGrid/Postmark/etc.'s SMTP relay, ...).
Email__Provider=development
Email__From=no-reply@ours.app
Email__FromName=Ours

# Only read when Email__Provider=smtp.
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUsername=
Email__SmtpPassword=CHANGE_ME

# Cloudflare R2 (added in Phase 4 — Photos). Not read by the app yet.
# R2__AccountId=
# R2__AccessKeyId=
# R2__SecretAccessKey=
# R2__BucketName=
