# Base URL of the Ours.Api backend. Exposed to app code as process.env.EXPO_PUBLIC_API_URL
# (any EXPO_PUBLIC_* var is inlined by Expo at build time — see src/utils/env.ts).
#
# - iOS Simulator: http://localhost:5100 works (it shares the host's network).
# - Android Emulator: use http://10.0.2.2:5100 (its alias for the host machine).
# - A physical device (Expo Go / dev build) on the same Wi-Fi: use your computer's LAN IP,
#   e.g. http://192.168.1.23:5100 — `ipconfig getifaddr en0` on macOS prints it.
EXPO_PUBLIC_API_URL=http://localhost:5100
